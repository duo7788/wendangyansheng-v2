# These values are read only by the Vercel serverless function in /api.
# Never prefix them with VITE_ and never put them in frontend source code.
KIMI_API_KEY="YOUR_MOONSHOT_API_KEY"
# Keep this configurable: select the model name available in your Kimi account.
KIMI_MODEL="kimi-k2.5"
# Optional: overrides the default temperature of 0.6 required by the Kimi endpoint.
# KIMI_TEMPERATURE="0.6"
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# Paste a new `sb_secret_...` key here, or a legacy `service_role` key.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SECRET_OR_SERVICE_ROLE_KEY"
